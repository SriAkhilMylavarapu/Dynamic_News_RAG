# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed; everything else has a default.

# Claude API key from https://console.anthropic.com/settings/keys
# (without it, `ask` shows the most relevant articles but no written answer)
ANTHROPIC_API_KEY=

# NEWSRAG_LLM_MODEL=claude-sonnet-5-5
# NEWSRAG_LLM_EFFORT=low                           # low | medium | high
# NEWSRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # run `newsrag reindex` after changing
# NEWSRAG_DATA_DIR=./data
# NEWSRAG_FEEDS_FILE=./feeds.toml
# NEWSRAG_RETENTION_DAYS=30
# NEWSRAG_MAX_ITEMS_PER_FEED=25
# NEWSRAG_PER_DOMAIN_DELAY=1.0
# NEWSRAG_STORY_SIMILARITY=0.86
# NEWSRAG_RECENCY_HALF_LIFE_HOURS=72
# NEWSRAG_TOP_K=8
